{
  "name": "YourDulceria: Generación de Catálogo",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "position": [0, 144],
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1
    },
    {
      "parameters": {
        "command": "find \"/data/yourdulceria/catalogo yourdulceria\" -maxdepth 1 -type f -not -path \"*/.*\""
      },
      "id": "execute-find-command",
      "name": "Leer Fotos YourDulceria",
      "position": [400, 0],
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json.stdout;\nif (!result) return [];\n\nconst lines = result.split('\\n').filter(l => l.trim() !== '');\nconst EXT = /\\.(jpg|jpeg|png|webp|gif)$/i;\n\nfunction normalizeName(str) {\n  if (!str) return '';\n  return String(str)\n    .normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\")\n    .toUpperCase()\n    .replace(/[^A-Z0-9]/g, '');\n}\n\nconst out = [];\nfor (const fullPath of lines) {\n  if (!EXT.test(fullPath)) continue;\n  const fileName = fullPath.split('/').pop();\n  const baseName = fileName.replace(/\\.[^.]+$/i, '');\n  const matchKey = normalizeName(baseName);\n  \n  out.push({ json: { path: fullPath, fileName, matchKey } });\n}\nreturn out;"
      },
      "id": "code-parse-paths",
      "name": "Parsear Fotos",
      "position": [600, 0],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const categories = ['CARAMELOS', 'CHOCOLATES', 'GALLETAS', 'GOMITAS', 'PALETAS', 'BOMBONES', 'TURRONES', 'MALVAVISCOS'];\nconst results = [];\n\nfunction normalizeName(str) {\n  if (!str) return '';\n  return String(str)\n    .normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\")\n    .toUpperCase()\n    .replace(/[^A-Z0-9]/g, '');\n}\n\nreturn [{ json: { msg: 'start' } }];"
      },
      "id": "placeholder-data",
      "name": "Init Data",
      "position": [200, 272],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex",
        "options": {}
      },
      "id": "merge-data",
      "name": "Unir Todo",
      "position": [850, 144],
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst seenCategories = {};\nconst out = [];\n\nconst categories = ['CARAMELOS', 'CHOCOLATES', 'GALLETAS', 'GOMITAS', 'PALETAS', 'BOMBONES', 'TURRONES', 'MALVAVISCOS'];\n\nlet priceBase = 150;\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i].json;\n  const catIndex = i % categories.length;\n  const category = categories[catIndex];\n  \n  if (!seenCategories[category]) seenCategories[category] = 0;\n  \n  if (seenCategories[category] < 10) {\n    seenCategories[category]++;\n    \n    const priceCup = priceBase + (i * 10);\n    const priceUsd = (priceCup / 150).toFixed(2);\n    \n    out.push({\n      json: {\n        ...item,\n        category,\n        productId: item.fileName.replace(/\\.[^.]+$/i, ''),\n        cupFormatted: priceCup.toLocaleString() + ' CUP',\n        usdFormatted: priceUsd + ' USD'\n      }\n    });\n  }\n}\n\nreturn out;"
      },
      "id": "filter-and-price",
      "name": "Filtrar 10 x Tipo + Precios",
