    {
      "parameters": {
        "jsCode": "function levenshtein(a, b) {\n  if (a.length === 0) return b.length;\n  if (b.length === 0) return a.length;\n  const matrix = [];\n  for (let i = 0; i <= b.length; i++) { matrix[i] = [i]; }\n  for (let j = 0; j <= a.length; j++) { matrix[0][j] = j; }\n  for (let i = 1; i <= b.length; i++) {\n    for (let j = 1; j <= a.length; j++) {\n      if (b.charAt(i - 1) === a.charAt(j - 1)) {\n        matrix[i][j] = matrix[i - 1][j - 1];\n      } else {\n        matrix[i][j] = Math.min(\n          matrix[i - 1][j - 1] + 1,\n          Math.min(matrix[i][j - 1] + 1, matrix[i - 1][j] + 1)\n        );\n      }\n    }\n  }\n  return matrix[b.length][a.length];\n}\n\nconst unmatchedFiles = $input.all();\nif (!unmatchedFiles || unmatchedFiles.length === 0) return [];\n\nconst allProducts = $node[\"CleanPricing\"].all();\nconst recovered = [];\n\nfor (const file of unmatchedFiles) {\n  const fileKey = file.json.matchKey || \"\";\n  if (!fileKey) continue;\n  \n  let bestMatch = null;\n  let bestSimilarity = 0;\n\n  for (const product of allProducts) {\n    const prodKey = product.json.matchKey || \"\";\n    if (!prodKey) continue;\n    \n    const distance = levenshtein(fileKey, prodKey);\n    const maxLength = Math.max(fileKey.length, prodKey.length);\n    const similarity = maxLength === 0 ? 1 : (maxLength - distance) / maxLength;\n\n    if (similarity >= 0.8 && similarity > bestSimilarity) {\n      bestSimilarity = similarity;\n      bestMatch = product.json;\n    }\n  }\n\n  if (bestMatch) {\n    recovered.push({\n      json: {\n        ...bestMatch,\n        path: file.json.path,\n        fileName: file.json.fileName,\n        categoryRaw: file.json.categoryRaw\n      }\n    });\n  }\n}\n\nreturn recovered;"
      },
