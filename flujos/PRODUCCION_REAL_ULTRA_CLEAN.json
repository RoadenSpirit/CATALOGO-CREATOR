      "parameters": {
        "jsCode": "const result = $input.first().json.stdout;\nif (!result) return [];\nconst lines = result.split('\\n').map(l => l.trim()).filter(l => l !== '');\nconst out = [];\nfor (const fullPath of lines) {\n  const parts = fullPath.split('/');\n  const fileName = parts.pop();\n  const categoryRaw = parts.pop();\n  if (!categoryRaw) continue;\n  out.push({\n    json: {\n      path: fullPath,\n      fileName,\n      categoryRaw,\n      matchKey: fileName.replace(/\\.[^.]+$/i, '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '')\n    }\n  });\n}\nreturn out;"
      },
