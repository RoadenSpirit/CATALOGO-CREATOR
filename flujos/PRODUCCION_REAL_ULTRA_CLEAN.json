    {
      "parameters": {
        "jsCode": "// 1. EXTRACCIÓN Y VALIDACIÓN DE LA TASA DE CAMBIO\n// Llamamos exactamente al nodo maestro por su nombre literal: 'CONFIG'\nconst nodoConfig = $('CONFIG').first();\n\nif (!nodoConfig || !nodoConfig.json.TASA_CAMBIO_CUP) {\n    throw new Error(\"ERROR CRÍTICO: No se detectó la variable TASA_CAMBIO_CUP en el nodo CONFIG. Revise el enrutamiento.\");\n}\n\nconst tasaCambio = parseFloat(nodoConfig.json.TASA_CAMBIO_CUP);\n\n// Escudo de integridad financiera\nif (isNaN(tasaCambio) || tasaCambio <= 0) {\n    throw new Error(`ERROR DE NEGOCIO: La tasa de cambio introducida (${nodoConfig.json.TASA_CAMBIO_CUP}) no es válida.`);\n}\n\n// 2. PROCESAMIENTO OPTIMIZADO DEL BATCH DE PRODUCTOS\nfor (const item of $input.all()) {\n    const producto = item.json;\n    \n    // Tomamos el ancla inamovible: El precio en USD\n    const precioUSD = parseFloat(producto['ACTUAL USD']);\n\n    // Solo aplicamos la matemática si el producto tiene un precio válido en USD\n    if (!isNaN(precioUSD) && precioUSD > 0) {\n        \n        // A. CÁLCULO MATEMÁTICO (Redondeo comercial)\n        const nuevoPrecioCUP = Math.round(precioUSD * tasaCambio);\n        \n        // B. SOBRESCRITURA DE DATOS DUROS (Backend)\n        producto['ACTUAL CUP'] = nuevoPrecioCUP;\n        producto['cupPrice'] = nuevoPrecioCUP;\n        \n        // C. FORMATEO VISUAL PREMIUM (Frontend / UI)\n        producto['cupFormatted'] = `$${nuevoPrecioCUP.toLocaleString('en-US')} CUP`;\n    }\n}\n\n// 3. RETORNO DEL PAYLOAD LIMPIO Y ACTUALIZADO\nreturn $input.all();"
      },
