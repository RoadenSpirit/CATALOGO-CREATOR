    {
      "parameters": {
        "jsCode": "const allItems = $('🔀 ¿Categoría Válida?').all();\nconst pendientes = allItems.filter(item => {\n    const estado = (item.json?.ESTADO || '').toString().trim().toUpperCase();\n    return estado !== 'COMPLETADO';\n});\n\nconst groups = {};\npendientes.forEach(item => {\n  const cat = (item.json?.CATEGORÍA || item.json?.CATEGORIA || 'GENERAL').toString().trim().toUpperCase();\n  if (!groups[cat]) groups[cat] = [];\n  groups[cat].push(item.json);\n});\n\nconst batches = [];\nconst batchSize = $('⚙️ Variables Globales').first().json.ZIP_BATCH_SIZE || 30;\n\nfor (const [category, items] of Object.entries(groups)) {\n  for (let i = 0; i < items.length; i += batchSize) {\n    const chunk = items.slice(i, i + batchSize);\n    batches.push({\n      json: {\n        category: category,\n        batchIndex: Math.floor(i / batchSize) + 1,\n        totalItems: chunk.length,\n        items: chunk\n      }\n    });\n  }\n}\n\nreturn batches;"
      },
