      "parameters": {
        "jsCode": "let pendientes = 50;\ntry {\n    const sheetRows = $('Get row(s) in sheet').all();\n    if (Array.isArray(sheetRows)) {\n        pendientes = sheetRows.length;\n    }\n} catch(e) {}\n\nlet segundosEspera = 15;\n\nif (pendientes < 100) segundosEspera = 10;\nif (pendientes < 50)  segundosEspera = 6;\nif (pendientes < 15)  segundosEspera = 3;\n\nconst variacion = Math.random() * 2 - 1;\nlet tiempoFinal = Math.max(2, Math.round(segundosEspera + variacion));\n\nreturn [{ json: { sleepTimeSecs: tiempoFinal } }];"
      },
