    {
      "parameters": {
        "jsCode": "// Limpieza + categoría desde secciones (--- ACCESORIOS ---) y compositeKey para emparejar\nconst items = $input.all();\nconst cleaned = [];\nconst COL = { \n  codigo: 'CÓDIGO', \n  nombre: 'NOMBRE', \n  precioUsd: 'PRECIO USD', \n  precioCup: 'PRECIO CUP',\n  precioAntiguoUsd: 'PRECIO ANTIGUO USD',\n  precioAntiguoCup: 'PRECIO ANTIGUO CUP',\n  estado: 'ESTADO' \n};\n\nfunction safeNum(val) {\n  if (val === null || val === undefined || val === '') return null;\n  if (typeof val === 'number' && !Number.isNaN(val)) return val;\n  const s = String(val).replace(/[^0-9.,]/g, '').replace(',', '.');\n  const n = parseFloat(s);\n  return Number.isNaN(n) ? null : n;\n}\n\nfunction safeStr(val) {\n  if (val === null || val === undefined) return '';\n  return String(val).trim();\n}\n\nfunction normalizeName(str) {\n  if (!str) return '';\n  return String(str)\n    .normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\")\n    .toUpperCase()\n    .replace(/[^A-Z0-9]/g, '');\n}\n\nfunction isSectionHeader(codigo, nombre) {\n  const c = String(codigo || '').trim();\n  const n = safeStr(nombre);\n  return c.includes('---') || (!n && !c);\n}\n\nfunction sectionToCategory(codigo) {\n  const m = String(codigo).match(/---\\s*([^---]+)\\s*---/);\n  return m ? normalizeName(m[1]) : null;\n}\n\nlet currentCategory = '';\n\nfor (const item of items) {\n  const row = item.json || item;\n  const codigoRaw = row[COL.codigo];\n  const nombre = safeStr(row[COL.nombre]);\n  \n  if (isSectionHeader(codigoRaw, nombre)) {\n    const cat = sectionToCategory(codigoRaw);\n    if (cat) currentCategory = cat;\n    continue;\n  }\n  \n  if (!nombre) continue;\n\n  const usd = safeNum(row[COL.precioUsd]);\n  const cup = safeNum(row[COL.precioCup]);\n  const oldUsd = safeNum(row[COL.precioAntiguoUsd]);\n  const oldCup = safeNum(row[COL.precioAntiguoCup]);\n\n  const matchKey = normalizeName(nombre);\n  const compositeKey = matchKey + '|' + currentCategory;\n\n  // Determinar si hay rebaja real (actual < antiguo)\n  const isSale = (oldUsd !== null && usd < oldUsd);\n  \n  // Formateo de precios\n  const usdFormatted = usd !== null ? `$${usd.toFixed(2)}` : 'N/A';\n  const cupFormatted = cup !== null ? `${cup.toLocaleString()} CUP` : 'N/A';\n  const oldUsdFormatted = oldUsd !== null ? `$${oldUsd.toFixed(2)}` : '';\n  const oldCupFormatted = oldCup !== null ? `${oldCup.toLocaleString()} CUP` : '';\n  \n  // Cálculo de ahorro\n  let savingsLabel = '';\n  if (isSale) {\n    const diff = oldUsd - usd;\n    savingsLabel = `AHORRAS $${diff.toFixed(2)}`;\n  }\n\n  cleaned.push({ \n    json: { \n      productId: nombre,\n      usd, \n      cup, \n      oldUsd,\n      oldCup,\n      usdFormatted, \n      cupFormatted,\n      oldUsdFormatted,\n      oldCupFormatted,\n      isSale,\n      savingsLabel,\n      category: currentCategory,\n      matchKey,\n      compositeKey\n    } \n  });\n}\n\nreturn cleaned;"
      },
