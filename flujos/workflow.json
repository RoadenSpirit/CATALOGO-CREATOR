        "command": "find /data/your-photos-folder -mindepth 2 -type f -not -path \"*/.*\""
      },
      "id": "execute-find-command",
      "name": "Leer Carpetas de Fotos (Comando Nivel SO)",
      "position": [
        672,
        0
      ],
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1
    },
    {
      "parameters": {
        "jsCode": "// Transforma el texto de rutas entregado por OS nativo en el diccionario y compositeKey\nconst result = $input.first().json.stdout;\nif (!result) return [];\n\nconst lines = result.split('\\n').filter(l => l.trim() !== '');\nconst EXT = /\\.(jpg|jpeg|png|webp|gif)$/i;\n\n// Nomalización FUERTE: Quita acentos, todo a MAYÚSCULAS y elimina todo lo que no sea A-Z o números\nfunction normalizeName(str) {\n  if (!str) return '';\n  return String(str)\n    .normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\") // Quitar acentos/diacríticos\n    .toUpperCase() // Convertir a mayúsculas\n    .replace(/[^A-Z0-9]/g, ''); // Eliminar espacios, guiones, símbolos de $, etc.\n}\n\nconst out = [];\n\nfor (const fullPath of lines) {\n  if (!EXT.test(fullPath)) continue;\n  \n  const parts = fullPath.split('/');\n  const fileName = parts.pop();\n  const categoryRaw = parts.pop();\n  \n  if (!categoryRaw) continue;\n  \n  const category = normalizeName(categoryRaw);\n  const baseName = fileName.replace(/\\.[^.]+$/i, ''); // remover extensión\n  const matchKey = normalizeName(baseName);\n  \n  // Nuestra llave maestra inquebrantable\n  const compositeKey = matchKey + '|' + category;\n  \n  out.push({ json: { path: fullPath, fileName, categoryRaw, category, matchKey, compositeKey } });\n}\n\nreturn out;"
      },
      "id": "code-parse-paths",
      "name": "Convertir Lista a Items",
      "position": [
        880,
        0
      ],
      "type": "n8n-nodes-base.code",
