        "jsCode": "// Tomar el binario del logo redimensionado del flujo paralelo\n// y añadirlo al ítem actual bajo el nombre 'logo'\nconst items = $input.all();\nconst logoNodeData = $('Redimensionar Logo').first();\n\nif (logoNodeData && logoNodeData.binary && logoNodeData.binary.logo) {\n  for (let item of items) {\n    item.binary = item.binary || {};\n    item.binary.logo = logoNodeData.binary.logo;\n  }\n}\n\nreturn items;"
