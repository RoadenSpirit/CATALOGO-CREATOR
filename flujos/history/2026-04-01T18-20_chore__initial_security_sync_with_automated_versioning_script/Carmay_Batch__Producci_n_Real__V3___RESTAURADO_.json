      "parameters": {
        "jsCode": "const nodoConfig = $('CONFIG').first();\nconst tasaCambio = parseFloat(nodoConfig.json.TASA_CAMBIO_CUP);\nfor (const item of $input.all()) {\n    const producto = item.json;\n    const precioUSD = parseFloat(producto['ACTUAL USD']);\n    if (!isNaN(precioUSD) && precioUSD > 0) {\n        const nuevoPrecioCUP = Math.round(precioUSD * tasaCambio);\n        producto['ACTUAL CUP'] = nuevoPrecioCUP;\n        producto['cupPrice'] = nuevoPrecioCUP;\n        producto['cupFormatted'] = `$${nuevoPrecioCUP.toLocaleString('en-US')} CUP`;\n    }\n}\nreturn $input.all();"
      },
