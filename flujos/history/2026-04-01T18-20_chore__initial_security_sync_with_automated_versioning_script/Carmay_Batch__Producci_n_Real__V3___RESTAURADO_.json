    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\n\nfunction normalizeName(str) {\n  if (!str) return '';\n  return String(str).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '');\n}\n\nconst formatUsd = (val) => '$' + val.toLocaleString('en-US', {\n  minimumFractionDigits: 2,\n  maximumFractionDigits: 2\n}) + ' USD';\nconst formatCup = (val) => '$' + val.toLocaleString('en-US', {\n  maximumFractionDigits: 0\n}) + ' CUP';\n\nfor (const item of items) {\n  const row = item.json;\n  const nombre = row['PRODUCTO'] ? String(row['PRODUCTO']).trim() : '';\n  if (!nombre) continue;\n\n  const actualUsd = parseFloat(row['ACTUAL USD']) || 0;\n  const actualCup = parseFloat(row['ACTUAL CUP']) || 0;\n  const maxUsd = parseFloat(row['MAX HIST USD']) || 0;\n  const maxCup = parseFloat(row['MAX HIST CUP']) || 0;\n\n  const hasDiscount = (maxUsd > actualUsd) && (maxCup > actualCup);\n\n  out.push({\n    json: {\n      ...row,\n      matchKey: normalizeName(nombre),\n      productId: nombre,\n      usdPrice: actualUsd,\n      cupPrice: actualCup,\n      usdFormatted: formatUsd(actualUsd),\n      cupFormatted: formatCup(actualCup),\n      hasDiscount: hasDiscount,\n      maxUsdFormatted: hasDiscount ? formatUsd(maxUsd) : null,\n      maxCupFormatted: hasDiscount ? formatCup(maxCup) : null,\n      diffUsdFormatted: hasDiscount ? formatUsd(maxUsd - actualUsd) : null,\n      diffCupFormatted: hasDiscount ? formatUsd(maxCup - actualCup) : null,\n      categoryRaw: row['CATEGORIA'] || 'General'\n    }\n  });\n}\nreturn out;"
      },
