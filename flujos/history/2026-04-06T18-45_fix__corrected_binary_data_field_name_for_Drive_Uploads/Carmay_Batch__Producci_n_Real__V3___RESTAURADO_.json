        "jsCode": "const nodoConfig = $('CONFIG').first(); const tasaCambio = parseFloat(nodoConfig.json.TASA_CAMBIO_CUP); for (const item of $input.all()) { const producto = item.json; const precioUSD = parseFloat(producto['ACTUAL USD']); if (!isNaN(precioUSD) && precioUSD > 0) { const nuevoPrecioCUP = Math.round(precioUSD * tasaCambio); producto['ACTUAL CUP'] = nuevoPrecioCUP; producto['cupPrice'] = nuevoPrecioCUP; producto['cupFormatted'] = '$' + nuevoPrecioCUP.toLocaleString('en-US') + ' CUP'; } } return $input.all();"
