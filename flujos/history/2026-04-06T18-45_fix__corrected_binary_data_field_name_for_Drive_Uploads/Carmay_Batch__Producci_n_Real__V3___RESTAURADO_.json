    {
      "parameters": {
        "jsCode": "const items = $input.all(); const out = []; function normalizeName(str) { if (!str) return ''; return String(str).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, ''); } const formatUsd = (val) => '$' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD'; const formatCup = (val) => '$' + val.toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' CUP'; for (const item of items) { const row = item.json; const nombre = row['PRODUCTO'] ? String(row['PRODUCTO']).trim() : ''; if (!nombre) continue; const actualUsd = parseFloat(row['ACTUAL USD']) || 0; const actualCup = parseFloat(row['ACTUAL CUP']) || 0; const maxUsd = parseFloat(row['MAX HIST USD']) || 0; const maxCup = parseFloat(row['MAX HIST CUP']) || 0; const hasDiscount = (maxUsd > actualUsd) && (maxCup > actualCup); const tallas = []; for(let i=1; i<=9; i++){ const t = row['T'+i]; if(t && String(t).trim() !== '') tallas.push(String(t).trim()); } const tallaStr = tallas.join(', '); out.push({ json: { ...row, matchKey: normalizeName(nombre), productId: nombre, usdPrice: actualUsd, cupPrice: actualCup, usdFormatted: formatUsd(actualUsd), cupFormatted: formatCup(actualCup), hasDiscount: hasDiscount, maxUsdFormatted: hasDiscount ? formatUsd(maxUsd) : null, maxCupFormatted: hasDiscount ? formatCup(maxCup) : null, diffUsdFormatted: hasDiscount ? formatUsd(maxUsd - actualUsd) : null, diffCupFormatted: hasDiscount ? formatCup(maxCup - actualCup) : null, categoryRaw: row['CATEGORIA'] || 'General', talla: tallaStr } }); } return out;"
      },
