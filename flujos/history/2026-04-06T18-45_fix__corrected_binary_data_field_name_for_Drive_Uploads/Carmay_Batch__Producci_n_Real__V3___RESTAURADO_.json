    {
      "parameters": {
        "jsCode": "const allItems = $input.all(); const inventory = []; const filesMap = {}; const stateMap = {}; for (const item of allItems) { const j = item.json; if (!j.matchKey) continue; if (j.precioUsdExistente !== undefined) { stateMap[j.matchKey] = j; } else if (j.path) { if (!filesMap[j.matchKey]) filesMap[j.matchKey] = []; filesMap[j.matchKey].push(j); } else { inventory.push(j); } } const output = []; for (const p of inventory) { const key = p.matchKey; const productImages = filesMap[key] || []; if (productImages.length === 0) continue; const s = stateMap[key] || {}; const estadoActual = s.ESTADO || ''; const usdOld = parseFloat(s.precioUsdExistente) || 0; const cupOld = parseFloat(s.precioCupExistente) || 0; const usdNew = parseFloat(p.usdPrice) || 0; const cupNew = parseFloat(p.cupPrice) || 0; const hasPriceChanged = (usdOld !== usdNew) || (cupOld !== cupNew); const needsProcessing = !estadoActual.includes('PROCESADA') || hasPriceChanged; if (needsProcessing) { productImages.sort((a, b) => (a.preservedSuffix || '').length - (b.preservedSuffix || '').length); productImages.forEach((img, index) => { output.push({ json: { ...p, ...img, photoIndex: index + 1, totalPhotos: productImages.length, isGallery: productImages.length > 1, isFirstPhoto: index === 0, folderName: p.PRODUCTO } }); }); } } return output;"
