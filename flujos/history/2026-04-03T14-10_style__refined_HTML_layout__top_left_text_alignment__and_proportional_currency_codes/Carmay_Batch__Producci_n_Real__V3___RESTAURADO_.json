      "parameters": {
        "jsCode": "const result = $input.first().json.stdout; if (!result) return []; const lines = result.split(String.fromCharCode(10)).map(l => l.trim()).filter(l => l !== ''); const out = []; for (const fullPath of lines) { const parts = fullPath.split('/'); const fileName = parts.pop(); const categoryRaw = parts.pop(); if (!categoryRaw) continue; out.push({ json: { path: fullPath, fileName: fileName, categoryRaw: categoryRaw, matchKey: fileName.replace(/\\.[^.]+$/i, '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '') } }); } return out;"
