      "id": "merge-data",
      "name": "Unir Todo",
      "position": [850, 144],
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();
const seenCategories = {};
const out = [];

// Asignamos una categoría de las 8 disponibles de forma rotativa o aleatoria para la prueba
const categories = ['CARAMELOS', 'CHOCOLATES', 'GALLETAS', 'GOMITAS', 'PALETAS', 'BOMBONES', 'TURRONES', 'MALVAVISCOS'];

let priceBase = 150;

for (let i = 0; i < items.length; i++) {
  const item = items[i].json;
  const catIndex = i % categories.length;
  const category = categories[catIndex];
  
  if (!seenCategories[category]) seenCategories[category] = 0;
  
  if (seenCategories[category] < 10) {
    seenCategories[category]++;
    
    const priceCup = priceBase + (i * 10);
    const priceUsd = (priceCup / 150).toFixed(2);
    
    out.push({
      json: {
        ...item,
        category,
        productId: item.fileName.replace(/\.[^.]+$/i, ''),
        cupFormatted: priceCup.toLocaleString() + ' CUP',
        usdFormatted: priceUsd + ' USD'
      }
    });
  }
}

return out;"
      },
