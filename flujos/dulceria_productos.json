    {
      "parameters": {
        "jsCode": "const result = $input.first().json.stdout;
if (!result) return [];

const lines = result.split('
').filter(l => l.trim() !== '');
const EXT = /\.(jpg|jpeg|png|webp|gif)$/i;

function normalizeName(str) {
  if (!str) return '';
  return String(str)
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .toUpperCase()
    .replace(/[^A-Z0-9]/g, '');
}

const out = [];
for (const fullPath of lines) {
  if (!EXT.test(fullPath)) continue;
  const fileName = fullPath.split('/').pop();
  const baseName = fileName.replace(/\.[^.]+$/i, '');
  const matchKey = normalizeName(baseName);
  
  out.push({ json: { path: fullPath, fileName, matchKey } });
}
return out;"
      },
      "id": "code-parse-paths",
      "name": "Parsear Fotos",
      "position": [600, 0],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const categories = ['CARAMELOS', 'CHOCOLATES', 'GALLETAS', 'GOMITAS', 'PALETAS', 'BOMBONES', 'TURRONES', 'MALVAVISCOS'];
const results = [];

function normalizeName(str) {
  if (!str) return '';
  return String(str)
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .toUpperCase()
    .replace(/[^A-Z0-9]/g, '');
}

// Simulamos productos basados en nombres de archivos conocidos o genéricos
// En este caso, el usuario quiere que el nombre del producto venga de las fotos
return [{ json: { msg: 'start' } }];"
