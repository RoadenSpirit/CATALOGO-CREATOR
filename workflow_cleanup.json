    {
      "id": "7f8e9a0b-1c2d-3e4f-5a6b-7c8d9e0f1a2b",
      "name": "⚙️ Construir Query Limpieza",
      "parameters": {
        "jsCode": "const folders = $input.all();\nconst ids = folders.map(f => \"'\" + f.json.id + \"' in parents\");\nconst query = \"(\" + ids.join(\" or \") + \") and mimeType contains 'image/' and trashed = false\";\nreturn [{ json: { driveQuery: query } }];"
      },
