    {
      "id": "code-identify-orphans-id",
      "name": "🧠 Identificar Huérfanos",
      "parameters": {
        "jsCode": "const sheetsData = $('📊 Leer Estados de Productos').all();\nconst driveData = $('🔍 Listar Fotos Destino (Drive)').all();\n\nconst normalize = (str) => str ? String(str).normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '') : '';\n\n// 1. Mapear productos en stock (todos los presentes en esta hoja)\nconst activeProducts = {};\nsheetsData.forEach(item => {\n  const prod = item.json;\n  if (prod.PRODUCTO) {\n    activeProducts[normalize(prod.PRODUCTO)] = true;\n  }\n});\n\nconst filesToDelete = [];\n\n// 2. Buscar fotos en Drive sin stock activo\ndriveData.forEach(item => {\n  const file = item.json;\n  const fileName = file.name;\n  if (!fileName) return;\n  \n  const baseWithoutExt = fileName.replace(/\\.[^.]+$/i, '');\n  \n  let matchKeyRaw = baseWithoutExt;\n  const suffixMatch = baseWithoutExt.match(/[\\s_\\-\\(]+(\\d+)\\)?$/);\n  if (suffixMatch) {\n    matchKeyRaw = baseWithoutExt.substring(0, suffixMatch.index);\n  }\n  \n  const baseKey = matchKeyRaw.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '');\n  \n  if (!activeProducts[baseKey]) {\n    filesToDelete.push({\n      json: {\n        id: file.id,\n        name: fileName\n      }\n    });\n  }\n});\n\nreturn filesToDelete;"
      },
      "position": [
        620,
        360
      ],
