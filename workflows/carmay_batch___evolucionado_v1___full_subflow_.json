    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst cleaned = [];\n\nconst COL = { \n  codigo: 'CÓDIGO', \n  nombre: 'NOMBRE', \n  precioUsd: 'PRECIO USD', \n  precioCup: 'PRECIO CUP', \n  estado: 'ESTADO' \n};\n\nfunction safeNum(val) {\n  if (val === null || val === undefined) return null;\n  if (typeof val === 'number' && !Number.isNaN(val)) return val;\n  const s = String(val).replace(/[^0-9.,]/g, '').replace(',', '.');\n  const n = parseFloat(s);\n  return Number.isNaN(n) ? null : n;\n}\n\nfunction safeStr(val) {\n  if (val === null || val === undefined) return '';\n  return String(val).trim();\n}\n\nfunction normalizeName(str) {\n  if (!str) return '';\n  return String(str).normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toUpperCase().replace(/[^A-Z0-9]/g, '');\n}\n\nfunction isSectionHeader(codigo, nombre) {\n  const c = String(codigo).trim();\n  const n = safeStr(nombre);\n  return c.includes('---') || (!n && !c);\n}\n\nfunction sectionToCategory(codigo) {\n  const m = String(codigo).match(/---\\s*([^---]+)\\s*---/);\n  return m ? normalizeName(m[1]) : null;\n}\n\nlet currentCategory = '';\n\nfor (const item of items) {\n  const row = item.json || item;\n  \n  const codigoRaw = row[COL.codigo];\n  const nombre = safeStr(row[COL.nombre]);\n  const usd = safeNum(row[COL.precioUsd]);\n  const cup = safeNum(row[COL.precioCup]);\n  \n  if (isSectionHeader(codigoRaw, nombre)) {\n    const cat = sectionToCategory(codigoRaw);\n    if (cat) currentCategory = cat;\n    continue;\n  }\n  \n  if (!nombre) continue;\n  \n  const matchKey = normalizeName(nombre);\n  if (!matchKey) continue;\n  \n  const category = currentCategory || 'GENERAL';\n  const compositeKey = matchKey + '|' + category;\n  \n  cleaned.push({\n    json: {\n      matchKey,\n      category,\n      compositeKey,\n      codigo: codigoRaw,\n      productId: nombre,\n      usdPrice: usd,\n      cupPrice: cup,\n      usdFormatted: usd != null ? `$${Number(usd).toFixed(2)} USD` : '',\n      cupFormatted: cup != null ? `${Number(cup).toLocaleString('en-US')} CUP` : ''\n    }\n  });\n}\n\nreturn cleaned;"
      },
