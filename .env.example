# Database PostgreSQL Config
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=your_database_name

# n8n General Config
NODE_ENV=production
N8N_ENCRYPTION_KEY=your_encryption_key_v1

# Permisos especiales Sandbox para n8n
NODE_FUNCTION_ALLOW_BUILTIN=fs,path,os,process
NODE_FUNCTION_ALLOW_EXTERNAL=*

# Rutas del contenedor Linux
YOUR_PHOTOS_PATH=/data/your-photos-folder
YOUR_LOGO_PATH=/data/logo.png

# n8n API Settings
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=your_n8n_api_key_here

# Google Cloud
GOOGLE_CLOUD_PROJECT=your_project_id
GCP_PROJECT_ID=your_project_id

# Baileys WhatsApp API (Worker de Salida y Notificaciones)
BAILEYS_API_URL=http://whatsapp-api:3000
BAILEYS_API_KEY=your_baileys_api_key_here

